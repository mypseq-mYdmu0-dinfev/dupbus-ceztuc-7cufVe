{
  "_README": "Reference copy of this repo's hook registrations. These live in ~/.claude/settings.json (USER level), NOT in .claude/settings.json (project level), because the Claude Desktop app executes user-level hooks but silently ignores project-level ones. Each script self-scopes to this repo via the payload cwd, so global registration is safe. To restore on a new machine: merge the \"hooks\" object below into ~/.claude/settings.json and fix the absolute paths.",
  "hooks": {
    "PostCompact": [
      {
        "type": "command",
        "command": "/Volumes/FURY 2TB/Fury Documents/GitHub/dupbus-ceztuc-7cufVe/.claude/post_compact.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Volumes/FURY 2TB/Fury Documents/GitHub/dupbus-ceztuc-7cufVe/.sync/date_added.py' hook-capture"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Volumes/FURY 2TB/Fury Documents/GitHub/dupbus-ceztuc-7cufVe/.sync/date_added.py' hook-restore"
          }
        ]
      },
      {
