#!/bin/sh
# #sync guard (fail-safe). Restricts commits ONLY while the SYNC_ACTIVE marker
# exists (i.e. during `python3 cscpt/otg_sync.py`). Manual GH-Desktop commits have
# no marker -> the allowlist block is skipped and the pairing check runs instead.
MARKER="$(git rev-parse --git-dir)/SYNC_ACTIVE"
if [ -f "$MARKER" ]; then
  # `while read` rather than `for f in $staged`: git does NOT quote a path
  # merely because it contains a space, so word-splitting tore such a path into
  # fragments that could never match the allowlist —— an allowlisted file was
  # refused, and the message named half a filename. Line-wise reading is the
  # only form that survives a space; the same fix is applied to every loop below.
  if git diff --cached --name-only | while IFS= read -r f; do
      [ -n "$f" ] || continue
      if ! grep -qxF "$f" "$MARKER"; then
        echo "pre-commit: #sync blocked — '$f' is not in the allowlist:"
        cat "$MARKER"
        exit 9
      fi
    done
  then
    exit 0
  else
    exit 1
  fi
fi

# --- STRAY-SPACE FILENAME NET ---------------------------------------------
# Root CLAUDE.md §3.3 names comms files `[prefix]_[TS].md`, no space. At least
# four have been committed with a space wedged between the prefix underscore and
# the 12 digits (`close_ 202606142239.md`), each found by eye months later.
# The PRIMARY guard is `cscpt/flint.py`, a PreToolUse hook that blocks the
# offending Write outright. This is the SECOND net, and it exists because that
# one has a hole it cannot close: a PreToolUse hook only ever sees the harness's
# file tools, so a file created by Bash (`cp`, `touch`, a script) or by the user
# in Finder walks straight past it. Everything, however created, passes through
# here on its way into history.
#
# The rule is the one stated and calibrated in `cscpt/flint.py` (which also
# records why the broader "any whitespace" form was rejected): from the start of
# the BASENAME, a whitespace-free run ending `_`, then whitespace, then a
# 12-digit timestamp starting "20". ERE has no lookahead, so the trailing
# `([^0-9]|$)` stands in for the "not inside a longer digit run" boundary.
#
# BLOCK on an ADD, WARN on a MODIFY —— deliberately asymmetric. An ADD is the
# defect being introduced, which is the thing to make impossible. A MODIFY is a
# file that already exists: blocking it would deadlock any commit that touches a
# known offender (two are in the repo now, awaiting a sequenced rename), and the
# rename itself is a delete+add or an R, so a good new name is never caught.
# `while read` rather than `for f in $staged`: git does NOT quote a path merely
# because it contains a space, so word-splitting would tear the very filenames
# this check is about into two useless fragments.
stray_re='^[^[:space:]]*_[[:space:]]+20[0-9]{10}([^0-9]|$)'
git diff --cached --name-only --diff-filter=A | while IFS= read -r f; do
  base="${f##*/}"
  printf '%s\n' "$base" | grep -qE "$stray_re" || continue
  echo "pre-commit BLOCKED — '$f' has a stray space before its timestamp."
  echo "  Root CLAUDE.md §3.3: comms files are '[prefix]_[TS].md', with no space."
  echo "  Rename it first (move-only commit), e.g.:  git mv \"$f\" \"<no-space name>\""
  exit 9
done || exit 1

git diff --cached --name-only --diff-filter=M | while IFS= read -r f; do
  base="${f##*/}"
  printf '%s\n' "$base" | grep -qE "$stray_re" || continue
  echo "pre-commit reminder: '$f' has a stray space before its timestamp"
  echo "  (root CLAUDE.md §3.3). Rename it with 'git mv' in a move-only commit."
  echo "  (Non-blocking: this commit proceeds.)"
done

# No #sync marker: WARN (non-blocking) on an orphaned response_ so the committer is
# reminded to also push its query_ sibling if that file exists. This must NEVER block:
# a response_ may legitimately have no query_ (a short chat msg is quoted into the
# response_ itself), so an exit 1 here would wrongly refuse a valid commit. Mirror
# dlint's yellow flag (remind), not its red flag (block).
staged="$(git diff --cached --name-only --diff-filter=AM)"
printf '%s\n' "$staged" | while IFS= read -r f; do
  [ -n "$f" ] || continue
  base="${f##*/}"
  dir="${f%/*}"
  [ "$dir" = "$f" ] && dir="."
  # Match: optional CP prefix + response_ + 12-digit TS + .md
  ts="$(printf '%s\n' "$base" | sed -n 's/^\(.*_\)\{0,1\}response_\([0-9]\{12\}\)\.md$/\2/p')"
  [ -n "$ts" ] || continue
  prefix="$(printf '%s\n' "$base" | sed -n 's/^\(\(.*_\)\{0,1\}\)response_[0-9]\{12\}\.md$/\1/p')"
  sibbase="${prefix}query_${ts}.md"
  sibling="${dir}/${sibbase}"
  # PASS if sibling staged in this commit...
  if printf '%s\n' "$staged" | grep -qxF "$sibling"; then
    continue
  fi
  # ...or already tracked.
  if git ls-files --error-unmatch "$sibling" >/dev/null 2>&1; then
    continue
  fi
  echo "pre-commit reminder: response '$base' has no sibling query '$sibbase'"
  echo "  staged or tracked — if the user's query file exists, remember to push it too."
  echo "  (Non-blocking: this commit proceeds.)"
done

# --- REVERSE PAIRING ARM: a query_ with no response_ -----------------------
# The arm above checks ONE direction only — that a response_ has a query_. The
# reverse went unchecked for months, so an ORPHANED QUERY committed silently.
# That is the more expensive gap: root CLAUDE.md §3.5.3 makes a response_ carry
# its QUERY's timestamp, and the failure it permits is a new query answered by
# APPENDING to the previous turn's response_ — one file grows, no new file is
# created, and nothing anywhere complains. It happened live (a new query landed
# in the same commit as 83 appended lines on the prior turn's response_), and
# was caught by the user's eye, not by any check.
#
# ADDS ONLY (--diff-filter=A): a query_ is added once, and the ADD is the moment
# the obligation appears. Re-firing on every later MODIFY would nag over the
# ~30 historical orphans in this repo, which is how a reminder gets tuned out.
#
# NON-BLOCKING, exactly like the forward arm above, and for a stronger reason:
# a query legitimately answered inside ANOTHER response_ is a real, sanctioned
# case (a mid-turn follow-up per root CLAUDE.md §3.1.7.6.1, or a Move-Rule
# relocation into the comms tree), and NOTHING a script can read distinguishes
# it from the breach — the two produce byte-identical file operations, and the
# only difference is whether the agent was idle when the message arrived.
# Blocking would also deadlock a legitimate mid-turn checkpoint commit
# (§3.1.6.1.5), which lands a query_ before its response_ exists. The forward
# arm was itself demoted from block to reminder for the same class of reason;
# a reverse arm that blocked would be stricter than the direction with the
# HIGHER false-positive rate (74 unpaired responses on disk against ~33
# unpaired queries), which nothing could justify.
#
# NOT the real fix, deliberately recorded as such: by commit time the wrong file
# has already been written and the turn is over. The check that reaches the
# decision is `cscpt/hlint.py`'s prompt-time pairing reminder, which names the
# owed response_ before the turn's first write. This is the net beneath it, for
# whatever escapes — including any file created outside the harness's tools.
#
# `sessions/queued_queries/` is EXCLUDED: those queries deliberately await a
# future session (see that folder's README), so an unpaired one there is
# correct, never a defect. The blank `*_query_.md` TEMPLATES at the root of
# `sessions/` carry no 12-digit TS, so the pattern below never matches them.
git diff --cached --name-only --diff-filter=A | while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    queued_queries/*|*/queued_queries/*) continue ;;
  esac
  base="${f##*/}"
  dir="${f%/*}"
  [ "$dir" = "$f" ] && dir="."
  # A VOIDED file (root CLAUDE.md §8.2) is awaiting the user's manual delete, so
  # it owes nothing. `.*_` below would otherwise swallow the `❌_` prefix and
  # read it as a live query. `cscpt/hlint.py`'s twin check needs no such guard —
  # its prefix class is `[A-Za-z0-9-]+_`, which cannot match `❌_` at all.
  case "$base" in
    ❌_*) continue ;;
  esac
  # Match: optional CP prefix + query_ + 12-digit TS + .md
  ts="$(printf '%s\n' "$base" | sed -n 's/^\(.*_\)\{0,1\}query_\([0-9]\{12\}\)\.md$/\2/p')"
  [ -n "$ts" ] || continue
  prefix="$(printf '%s\n' "$base" | sed -n 's/^\(\(.*_\)\{0,1\}\)query_[0-9]\{12\}\.md$/\1/p')"
  sibbase="${prefix}response_${ts}.md"
  sibling="${dir}/${sibbase}"
  # PASS if the response is staged in this commit...
  if printf '%s\n' "$staged" | grep -qxF "$sibling"; then
    continue
  fi
  # ...or already tracked.
  if git ls-files --error-unmatch "$sibling" >/dev/null 2>&1; then
    continue
  fi
  echo "pre-commit reminder: query '$base' has no sibling response '$sibbase'"
  echo "  staged or tracked (root CLAUDE.md §3.5.3: a response_ carries its query's TS)."
  echo "  EXPECTED if this is a mid-turn checkpoint, or if that query was deliberately"
  echo "  answered inside another response_. A BREACH if a new turn's reply was appended"
  echo "  to an earlier response_ instead of getting its own file."
  echo "  (Non-blocking: this commit proceeds.)"
done
exit 0
